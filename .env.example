# Where downloaded OCR model weights are cached (Zenodo/HF files for kraken, GGUF, ...).
OLD_TATAR_OCR_MODELS=~/.cache/old_tatar_ocr/models

# Hugging Face cache (transformers models: CHURRO-3B, Azra-1-Mini, ...).
# HF_HOME=~/.cache/huggingface

# CPU threads for llama.cpp / torch backends (default: all cores).
# OLD_TATAR_OCR_THREADS=16

# Transkribus (metagrapho API) is NOT implemented in the baseline: it needs a paid
# Organisation plan and sends page images to a third-party server (EU, READ-COOP).
# TRANSKRIBUS_USER=
# TRANSKRIBUS_PASSWORD=
